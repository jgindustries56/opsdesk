# =============================================================================
# OpsDesk — per-client configuration
#
# This file IS the product differentiator. The code is identical for every
# client; this file is what makes it *their* system. Copy it to .env for local
# work, or paste the values into Railway → Variables for a deployment.
# =============================================================================

# ---- Which deployment is this? ----------------------------------------------
# staging  -> your personal test instance (shows a warning banner)
# production -> the client's live site (no banner, password required)
DEPLOY_ENV=staging
PORT=3000

# ---- Security ---------------------------------------------------------------
# Required whenever DEPLOY_ENV=production. The app refuses to boot without it.
APP_PASSWORD=change-me
# Any long random string. Rotating it signs everyone out.
SESSION_SECRET=change-me-to-something-long-and-random
SESSION_DAYS=14
# READ_ONLY=true turns the instance into a click-around demo.
READ_ONLY=false

# ---- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use a local SQLite file (zero setup, free).
# On Railway, add a Postgres service and reference it: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
SQLITE_PATH=./data/opsdesk.db

# ---- Client identity --------------------------------------------------------
COMPANY_NAME=Rox Jewellers
COMPANY_TAGLINE=Orders, repairs and payments in one place
COMPANY_EMAIL=hello@example.com
COMPANY_PHONE=+1 555 0100
COMPANY_ADDRESS=1 High Street, Springfield
COMPANY_WEBSITE=https://example.com
LOGO_URL=
FAVICON_EMOJI=

# ---- Look and feel ----------------------------------------------------------
BRAND_PRIMARY=#1f6feb
BRAND_ACCENT=#0f9d58
BRAND_DANGER=#d93025
BRAND_RADIUS=10px
BRAND_FONT=system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif
# auto | light | dark
THEME=auto

# ---- Vocabulary -------------------------------------------------------------
# Rename everything to match how the client actually talks. A jeweller has
# "clients" and "pieces"; a textile mill has "accounts" and "orders".
LABEL_CONTACT=Customer
LABEL_CONTACT_PLURAL=Customers
LABEL_INTAKE=Enquiry
LABEL_INTAKE_PLURAL=Enquiries
LABEL_JOB=Job
LABEL_JOB_PLURAL=Jobs
LABEL_INVOICE=Invoice
LABEL_INVOICE_PLURAL=Invoices
LABEL_PAYMENT=Payment
LABEL_PAYMENT_PLURAL=Payments

# ---- Money ------------------------------------------------------------------
CURRENCY=USD
CURRENCY_LOCALE=en-US
TAX_LABEL=Sales tax
DEFAULT_TAX_RATE=0
INVOICE_PREFIX=INV-
INVOICE_START_NUMBER=1001
PAYMENT_TERMS_DAYS=30
PAYMENT_TERMS_TEXT=Payment due within {{days}} days of invoice date.

# ---- Pipeline stages (comma separated, order matters) ------------------------
INTAKE_CHANNELS=Phone call,Email,Walk-in,Website,Referral,Social
INTAKE_STAGES=New,Contacted,Quoted,Won,Lost
JOB_STAGES=Draft,Scheduled,In progress,Blocked,Complete,Cancelled
PAYMENT_METHODS=Card,Cash,Bank transfer,Cheque,Other

# ---- Follow-up thresholds (days) --------------------------------------------
# The heart of the product: how long something can go quiet before it appears
# on the dashboard. Tighten these for fast-moving businesses.
FOLLOWUP_INTAKE_DAYS=3
FOLLOWUP_JOB_DAYS=7
FOLLOWUP_DRAFT_INVOICE_DAYS=2
FOLLOWUP_UNINVOICED_DAYS=2
FOLLOWUP_OVERDUE_GRACE_DAYS=0

# ---- Modules ----------------------------------------------------------------
# Drop what a client does not need. Fewer tabs = less training = happier client.
MODULES=contacts,intakes,jobs,invoices,payments,followups
